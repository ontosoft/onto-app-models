@prefix : <http://example.org/generated/> .
@prefix bbo: <https://www.irit.fr/recherches/MELODI/ontologies/BBO#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix obop: <http://purl.org/net/obop/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix shacl: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/generated/conference/AuthorShape> a shacl:NodeShape ;
    shacl:order 3 ;
    shacl:property [ shacl:datatype xsd:string ;
            shacl:name "Full name" ;
            shacl:order 0 ;
            shacl:path foaf:name ],
        [ shacl:datatype xsd:string ;
            shacl:name "Affiliation" ;
            shacl:order 1 ;
            shacl:path <http://example.org/generated/conference/affiliation> ],
        [ shacl:datatype xsd:string ;
            shacl:name "Email" ;
            shacl:order 2 ;
            shacl:path <http://schema.org/email> ] ;
    shacl:targetClass <http://example.org/generated/conference/Author> .

<http://example.org/generated/conference/ReviewShape> a shacl:NodeShape ;
    shacl:order 6 ;
    shacl:property [ shacl:datatype xsd:integer ;
            shacl:name "Score" ;
            shacl:order 0 ;
            shacl:path <http://example.org/generated/conference/score> ],
        [ shacl:datatype xsd:string ;
            shacl:name "Review text" ;
            shacl:order 1 ;
            shacl:path <http://example.org/generated/conference/reviewText> ],
        [ shacl:datatype xsd:dateTime ;
            shacl:name "Review date" ;
            shacl:order 2 ;
            shacl:path <http://example.org/generated/conference/reviewDate> ],
        [ shacl:node <http://example.org/generated/conference/PaperShape> ;
            shacl:order 3 ;
            shacl:path <http://example.org/generated/conference/reviews> ],
        [ shacl:class <http://example.org/generated/conference/Reviewer> ;
            shacl:order 4 ;
            shacl:path <http://example.org/generated/conference/writtenBy> ] ;
    shacl:targetClass <http://example.org/generated/conference/Review> .

<http://example.org/generated/conference/ReviewerShape> a shacl:NodeShape ;
    shacl:order 5 ;
    shacl:property [ shacl:datatype xsd:string ;
            shacl:name "Reviewer name" ;
            shacl:order 0 ;
            shacl:path <http://example.org/generated/conference/reviewerName> ],
        [ shacl:datatype xsd:string ;
            shacl:name "Affiliation" ;
            shacl:order 1 ;
            shacl:path <http://example.org/generated/conference/affiliation> ],
        [ shacl:datatype xsd:string ;
            shacl:name "Expertise" ;
            shacl:order 2 ;
            shacl:path <http://example.org/generated/conference/expertise> ] ;
    shacl:targetClass <http://example.org/generated/conference/Reviewer> .

:add_another_btn_author a obop:Button,
