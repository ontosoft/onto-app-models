    obop:activatesAction :add_another_action_author ;
    obop:belongsTo :author_notification_block ;
    obop:belongsToVisual :author_notification_layout ;
    obop:hasLabel "Add another Author" ;
    obop:hasPositionNumber "2"^^xsd:int .

