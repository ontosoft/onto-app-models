<http://example.org/generated/conference/ConferenceShape> a shacl:NodeShape ;
    shacl:order 0 ;
    shacl:property [ shacl:datatype xsd:string ;
            shacl:minCount 1 ;
            shacl:name "Conference title" ;
            shacl:order 0 ;
            shacl:path <http://schema.org/name> ],
        [ shacl:datatype xsd:string ;
            shacl:name "Acronym" ;
            shacl:order 1 ;
            shacl:path <http://example.org/generated/conference/acronym> ],
        [ shacl:datatype xsd:dateTime ;
            shacl:name "Start date" ;
            shacl:order 2 ;
            shacl:path <http://schema.org/startDate> ],
        [ shacl:datatype xsd:dateTime ;
            shacl:name "End date" ;
            shacl:order 3 ;
            shacl:path <http://schema.org/endDate> ] ;
    shacl:targetClass <http://example.org/generated/conference/Conference> .

<http://example.org/generated/conference/PaperShape> a shacl:NodeShape ;
    shacl:order 2 ;
    shacl:property [ shacl:datatype xsd:dateTime ;
            shacl:name "Submission date" ;
            shacl:order 2 ;
            shacl:path <http://example.org/generated/conference/submissionDate> ],
        [ shacl:node <http://example.org/generated/conference/TrackShape> ;
            shacl:order 3 ;
            shacl:path <http://example.org/generated/conference/submittedTo> ],
        [ shacl:class <http://example.org/generated/conference/Author> ;
            shacl:order 4 ;
            shacl:path <http://example.org/generated/conference/hasAuthor> ],
        [ shacl:node <http://example.org/generated/conference/SessionShape> ;
            shacl:order 5 ;
            shacl:path <http://example.org/generated/conference/presentedIn> ],
        [ shacl:datatype xsd:string ;
            shacl:minCount 1 ;
            shacl:name "Paper title" ;
            shacl:order 0 ;
            shacl:path <http://example.org/generated/conference/paperTitle> ],
        [ shacl:datatype xsd:string ;
            shacl:name "Abstract" ;
            shacl:order 1 ;
            shacl:path <http://example.org/generated/conference/abstract> ] ;
    shacl:targetClass <http://example.org/generated/conference/Paper> .

<http://example.org/generated/conference/SessionShape> a shacl:NodeShape ;
    shacl:order 4 ;
    shacl:property [ shacl:datatype xsd:string ;
            shacl:name "Session title" ;
            shacl:order 0 ;
            shacl:path <http://example.org/generated/conference/sessionTitle> ],
        [ shacl:datatype xsd:dateTime ;
            shacl:name "Session date" ;
            shacl:order 1 ;
            shacl:path <http://example.org/generated/conference/sessionDate> ],
        [ shacl:datatype xsd:string ;
            shacl:name "Room" ;
            shacl:order 2 ;
            shacl:path <http://example.org/generated/conference/room> ],
        [ shacl:node <http://example.org/generated/conference/TrackShape> ;
            shacl:order 3 ;
            shacl:path <http://example.org/generated/conference/partOfTrack> ] ;
    shacl:targetClass <http://example.org/generated/conference/Session> .

