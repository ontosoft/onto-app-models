<http://example.org/generated/conference/TrackShape> a shacl:NodeShape ;
    shacl:order 1 ;
    shacl:property [ shacl:datatype xsd:string ;
            shacl:minCount 1 ;
            shacl:name "Track title" ;
            shacl:order 0 ;
            shacl:path <http://example.org/generated/conference/trackTitle> ],
        [ shacl:datatype xsd:string ;
            shacl:name "Chair name" ;
            shacl:order 1 ;
            shacl:path <http://example.org/generated/conference/chairName> ],
        [ shacl:node <http://example.org/generated/conference/ConferenceShape> ;
            shacl:order 2 ;
            shacl:path <http://example.org/generated/conference/isTrackOf> ] ;
    shacl:targetClass <http://example.org/generated/conference/Track> .

