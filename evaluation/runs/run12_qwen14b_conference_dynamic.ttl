<http://example.org/generated/conference/Conference> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty <http://schema.org/startDate> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://example.org/generated/conference/acronym> ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:string ;
            owl:onProperty <http://schema.org/name> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://schema.org/name> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty <http://schema.org/endDate> ] .

<http://example.org/generated/conference/Paper> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://example.org/generated/conference/abstract> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://example.org/generated/conference/Session> ;
            owl:onProperty <http://example.org/generated/conference/presentedIn> ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:string ;
            owl:onProperty <http://example.org/generated/conference/paperTitle> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://example.org/generated/conference/paperTitle> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://example.org/generated/conference/Author> ;
            owl:onProperty <http://example.org/generated/conference/hasAuthor> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://example.org/generated/conference/Track> ;
            owl:onProperty <http://example.org/generated/conference/submittedTo> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty <http://example.org/generated/conference/submissionDate> ] .

<http://example.org/generated/conference/Session> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://example.org/generated/conference/room> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty <http://example.org/generated/conference/sessionDate> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://example.org/generated/conference/sessionTitle> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://example.org/generated/conference/Track> ;
            owl:onProperty <http://example.org/generated/conference/partOfTrack> ] .

