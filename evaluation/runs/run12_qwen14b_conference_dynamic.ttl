<http://example.org/generated/conference/Review> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://example.org/generated/conference/Paper> ;
            owl:onProperty <http://example.org/generated/conference/reviews> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty <http://example.org/generated/conference/score> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://example.org/generated/conference/Reviewer> ;
            owl:onProperty <http://example.org/generated/conference/writtenBy> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://example.org/generated/conference/reviewText> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty <http://example.org/generated/conference/reviewDate> ] .

