<http://purl.org/goodrelations/v1#BusinessEntity> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <http://example.org/generated/restaurant/Menu> ;
            owl:onProperty <http://purl.org/goodrelations/v1#offers> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://purl.org/goodrelations/v1#legalName> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://schema.org/postalCode> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://schema.org/streetAddress> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://example.org/generated/restaurant/Menu> ;
            owl:onProperty <http://schema.org/hasMenu> ] .

