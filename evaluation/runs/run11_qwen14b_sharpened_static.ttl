<http://example.org/generated/restaurant/description> a owl:DatatypeProperty .

<http://example.org/generated/restaurant/dishName> a owl:DatatypeProperty .

<http://example.org/generated/restaurant/hasIngredient> a owl:ObjectProperty .

<http://example.org/generated/restaurant/ingredientName> a owl:DatatypeProperty .

<http://example.org/generated/restaurant/menuType> a owl:DatatypeProperty .

<http://example.org/generated/restaurant/price> a owl:DatatypeProperty .

:submit_action_business_entity a obop:SubmitBlockAction,
        owl:NamedIndividual ;
    obop:actionInBlock :business_entity_block ;
    obop:hasInitiator "onClick",
        "onEnter" ;
    obop:hasLabel "Submit" .

:submit_action_dish a obop:SubmitBlockAction,
        owl:NamedIndividual ;
    obop:actionInBlock :dish_block ;
    obop:hasInitiator "onClick",
        "onEnter" ;
    obop:hasLabel "Submit" .

:submit_action_ingredient a obop:SubmitBlockAction,
        owl:NamedIndividual ;
    obop:actionInBlock :ingredient_block ;
    obop:hasInitiator "onClick",
        "onEnter" ;
    obop:hasLabel "Submit" .

:submit_action_menu a obop:SubmitBlockAction,
        owl:NamedIndividual ;
    obop:actionInBlock :menu_block ;
    obop:hasInitiator "onClick",
        "onEnter" ;
    obop:hasLabel "Submit" .

:user_enters_business_entity a owl:NamedIndividual,
        bbo:UserTask ;
    bbo:has_container :insert_business_entity .

:user_enters_dish a owl:NamedIndividual,
        bbo:UserTask ;
    bbo:has_container :insert_dish .

:user_enters_ingredient a owl:NamedIndividual,
        bbo:UserTask ;
    bbo:has_container :insert_ingredient .

:user_enters_menu a owl:NamedIndividual,
        bbo:UserTask ;
    bbo:has_container :insert_menu .

:validation_gateway_business_entity a owl:NamedIndividual,
        bbo:ExclusiveGateway ;
    bbo:has_container :insert_business_entity .

:validation_gateway_dish a owl:NamedIndividual,
        bbo:ExclusiveGateway ;
    bbo:has_container :insert_dish .

:validation_gateway_ingredient a owl:NamedIndividual,
        bbo:ExclusiveGateway ;
    bbo:has_container :insert_ingredient .

:validation_gateway_menu a owl:NamedIndividual,
        bbo:ExclusiveGateway ;
    bbo:has_container :insert_menu .

<http://purl.org/goodrelations/v1#legalName> a owl:DatatypeProperty .

<http://purl.org/goodrelations/v1#offers> a owl:ObjectProperty .

<http://schema.org/hasMenu> a owl:ObjectProperty .

<http://schema.org/postalCode> a owl:DatatypeProperty .

<http://schema.org/streetAddress> a owl:DatatypeProperty .

:business_entity_notification_block a obop:Block,
        owl:NamedIndividual ;
    rdfs:label "BusinessEntity saved - Notification"^^rdf:PlainLiteral ;
    obop:hasMainLayout :business_entity_notification_layout ;
    obop:hasPositionNumber "0"^^xsd:int .

:business_entity_shape a owl:NamedIndividual,
        shacl:NodeShape ;
    obop:modelBelongsTo :business_entity_block ;
    shacl:property [ obop:specifiedBy :field_business_entity_legal_name ;
            shacl:datatype xsd:string ;
            shacl:name "Restaurant name" ;
            shacl:order 0 ;
            shacl:path <http://purl.org/goodrelations/v1#legalName> ],
        [ obop:specifiedBy :field_business_entity_postal_code ;
            shacl:datatype xsd:string ;
            shacl:name "Postal code" ;
            shacl:order 2 ;
            shacl:path <http://schema.org/postalCode> ],
        [ shacl:node :menu_shape ;
            shacl:path <http://purl.org/goodrelations/v1#offers> ],
        [ shacl:node :menu_shape ;
            shacl:path <http://schema.org/hasMenu> ],
        [ obop:specifiedBy :field_business_entity_street_address ;
            shacl:datatype xsd:string ;
            shacl:name "Address" ;
            shacl:order 1 ;
            shacl:path <http://schema.org/streetAddress> ] ;
    shacl:targetClass <http://purl.org/goodrelations/v1#BusinessEntity> .

:business_entity_vlayout a obop:VerticalLayout,
        owl:NamedIndividual ;
    obop:belongsTo :business_entity_block ;
    obop:hasPositionNumber "0"^^xsd:int .

:dish_notification_block a obop:Block,
        owl:NamedIndividual ;
    rdfs:label "Dish saved - Notification"^^rdf:PlainLiteral ;
    obop:hasMainLayout :dish_notification_layout ;
    obop:hasPositionNumber "0"^^xsd:int .

:dish_vlayout a obop:VerticalLayout,
        owl:NamedIndividual ;
    obop:belongsTo :dish_block ;
    obop:hasPositionNumber "0"^^xsd:int .

:ingredient_notification_layout a obop:VerticalLayout,
        owl:NamedIndividual ;
    obop:belongsTo :ingredient_notification_block ;
    obop:hasPositionNumber "0"^^xsd:int .

:ingredient_vlayout a obop:VerticalLayout,
        owl:NamedIndividual ;
    obop:belongsTo :ingredient_block ;
    obop:hasPositionNumber "0"^^xsd:int .

:menu_notification_block a obop:Block,
        owl:NamedIndividual ;
    rdfs:label "Menu saved - Notification"^^rdf:PlainLiteral ;
    obop:hasMainLayout :menu_notification_layout ;
    obop:hasPositionNumber "0"^^xsd:int .

:menu_vlayout a obop:VerticalLayout,
        owl:NamedIndividual ;
    obop:belongsTo :menu_block ;
    obop:hasPositionNumber "0"^^xsd:int .

<http://example.org/generated/restaurant/Ingredient> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://example.org/generated/restaurant/ingredientName> ] .

<http://example.org/generated/restaurant/menuName> a owl:DatatypeProperty .

:continue_action a obop:Action,
        owl:NamedIndividual ;
    obop:hasInitiator "onClick" ;
    obop:hasLabel "Continue" ;
    rdfs:comment "Advance the workflow from a notification screen to the next step." .

:dish_shape a owl:NamedIndividual,
        shacl:NodeShape ;
    obop:modelBelongsTo :dish_block ;
    shacl:property [ obop:specifiedBy :field_dish_price ;
            shacl:datatype xsd:decimal ;
            shacl:name "Price" ;
            shacl:order 1 ;
            shacl:path <http://example.org/generated/restaurant/price> ],
        [ shacl:node :menu_shape ;
            shacl:path <http://example.org/generated/restaurant/belongsToMenu> ],
        [ obop:specifiedBy :field_dish_dish_name ;
            shacl:datatype xsd:string ;
            shacl:name "Dish name" ;
            shacl:order 0 ;
            shacl:path <http://example.org/generated/restaurant/dishName> ],
        [ shacl:node :ingredient_shape ;
            shacl:path <http://example.org/generated/restaurant/hasIngredient> ],
        [ obop:specifiedBy :field_dish_description ;
            shacl:datatype xsd:string ;
            shacl:name "Description" ;
            shacl:order 2 ;
            shacl:path <http://example.org/generated/restaurant/description> ] ;
    shacl:targetClass <http://example.org/generated/restaurant/Dish> .

:ingredient_notification_block a obop:Block,
        owl:NamedIndividual ;
    rdfs:label "Ingredient saved - Notification"^^rdf:PlainLiteral ;
    obop:hasMainLayout :ingredient_notification_layout ;
    obop:hasPositionNumber "0"^^xsd:int .

<http://example.org/generated/restaurant/Menu> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://example.org/generated/restaurant/menuName> ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:string ;
            owl:onProperty <http://example.org/generated/restaurant/menuName> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://example.org/generated/restaurant/menuType> ] .

:menu_shape a owl:NamedIndividual,
        shacl:NodeShape ;
    obop:modelBelongsTo :menu_block ;
    shacl:property [ obop:specifiedBy :field_menu_menu_type ;
            shacl:datatype xsd:string ;
            shacl:name "Menu type" ;
            shacl:order 1 ;
            shacl:path <http://example.org/generated/restaurant/menuType> ],
        [ obop:specifiedBy :field_menu_menu_name ;
            shacl:datatype xsd:string ;
            shacl:minCount 1 ;
            shacl:name "Menu name" ;
            shacl:order 0 ;
            shacl:path <http://example.org/generated/restaurant/menuName> ] ;
    shacl:targetClass <http://example.org/generated/restaurant/Menu> .

:ingredient_block a obop:Block,
        owl:NamedIndividual ;
    rdfs:label "Ingredient data"^^rdf:PlainLiteral ;
    obop:hasMainLayout :ingredient_vlayout ;
    obop:hasPositionNumber "0"^^xsd:int ;
    obop:targetClass <http://example.org/generated/restaurant/Ingredient> .

:business_entity_block a obop:Block,
        owl:NamedIndividual ;
    rdfs:label "BusinessEntity data"^^rdf:PlainLiteral ;
    obop:hasMainLayout :business_entity_vlayout ;
    obop:hasPositionNumber "0"^^xsd:int ;
    obop:targetClass <http://purl.org/goodrelations/v1#BusinessEntity> .

:menu_block a obop:Block,
        owl:NamedIndividual ;
    rdfs:label "Menu data"^^rdf:PlainLiteral ;
    obop:hasMainLayout :menu_vlayout ;
    obop:hasPositionNumber "0"^^xsd:int ;
    obop:targetClass <http://example.org/generated/restaurant/Menu> .

:dish_block a obop:Block,
        owl:NamedIndividual ;
    rdfs:label "Dish data"^^rdf:PlainLiteral ;
    obop:hasMainLayout :dish_vlayout ;
    obop:hasPositionNumber "0"^^xsd:int ;
    obop:targetClass <http://example.org/generated/restaurant/Dish> .

:app_process a owl:NamedIndividual,
        bbo:Process .

:insert_business_entity a owl:NamedIndividual,
        bbo:SubProcess ;
    rdfs:comment "Insert BusinessEntity data." ;
    bbo:has_container :app_process .

:insert_dish a owl:NamedIndividual,
        bbo:SubProcess ;
    rdfs:comment "Insert Dish data." ;
    bbo:has_container :app_process .

:insert_menu a owl:NamedIndividual,
        bbo:SubProcess ;
    rdfs:comment "Insert Menu data." ;
    bbo:has_container :app_process .

:insert_ingredient a owl:NamedIndividual,
        bbo:SubProcess ;
    rdfs:comment "Insert Ingredient data." ;
    bbo:has_container :app_process .

