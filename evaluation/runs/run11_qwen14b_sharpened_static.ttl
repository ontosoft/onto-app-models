<http://example.org/generated/restaurant/Dish> a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://example.org/generated/restaurant/dishName> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty <http://example.org/generated/restaurant/price> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://example.org/generated/restaurant/Menu> ;
            owl:onProperty <http://example.org/generated/restaurant/belongsToMenu> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://example.org/generated/restaurant/description> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <http://example.org/generated/restaurant/Ingredient> ;
            owl:onProperty <http://example.org/generated/restaurant/hasIngredient> ] .

<http://example.org/generated/restaurant/MenuShape> a shacl:NodeShape ;
    shacl:order 1 ;
    shacl:property [ shacl:datatype xsd:string ;
            shacl:minCount 1 ;
            shacl:name "Menu name" ;
            shacl:order 0 ;
            shacl:path <http://example.org/generated/restaurant/menuName> ],
        [ shacl:datatype xsd:string ;
            shacl:name "Menu type" ;
            shacl:order 1 ;
            shacl:path <http://example.org/generated/restaurant/menuType> ] ;
    shacl:targetClass <http://example.org/generated/restaurant/Menu> .

