@prefix : <http://example.org/generated/> .
@prefix bbo: <https://www.irit.fr/recherches/MELODI/ontologies/BBO#> .
@prefix obop: <http://purl.org/net/obop/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix shacl: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/generated/restaurant/DishShape> a shacl:NodeShape ;
    shacl:order 2 ;
    shacl:property [ shacl:datatype xsd:string ;
            shacl:name "Description" ;
            shacl:order 2 ;
            shacl:path <http://example.org/generated/restaurant/description> ],
        [ shacl:node <http://example.org/generated/restaurant/MenuShape> ;
            shacl:order 3 ;
            shacl:path <http://example.org/generated/restaurant/belongsToMenu> ],
        [ shacl:class <http://example.org/generated/restaurant/Ingredient> ;
            shacl:order 4 ;
            shacl:path <http://example.org/generated/restaurant/hasIngredient> ],
        [ shacl:datatype xsd:string ;
            shacl:name "Dish name" ;
            shacl:order 0 ;
            shacl:path <http://example.org/generated/restaurant/dishName> ],
        [ shacl:datatype xsd:decimal ;
            shacl:name "Price" ;
            shacl:order 1 ;
            shacl:path <http://example.org/generated/restaurant/price> ] ;
    shacl:targetClass <http://example.org/generated/restaurant/Dish> .

<http://example.org/generated/restaurant/IngredientShape> a shacl:NodeShape ;
    shacl:order 3 ;
    shacl:property [ shacl:datatype xsd:string ;
            shacl:name "Ingredient name" ;
            shacl:order 0 ;
            shacl:path <http://example.org/generated/restaurant/ingredientName> ] ;
    shacl:targetClass <http://example.org/generated/restaurant/Ingredient> .

<http://example.org/generated/restaurant/RestaurantShape> a shacl:NodeShape ;
    shacl:order 0 ;
    shacl:property [ shacl:datatype xsd:string ;
            shacl:name "Restaurant name" ;
            shacl:order 0 ;
            shacl:path <http://purl.org/goodrelations/v1#legalName> ],
        [ shacl:datatype xsd:string ;
            shacl:name "Address" ;
            shacl:order 1 ;
            shacl:path <http://schema.org/streetAddress> ],
        [ shacl:datatype xsd:string ;
            shacl:name "Postal code" ;
            shacl:order 2 ;
            shacl:path <http://schema.org/postalCode> ],
        [ shacl:node <http://example.org/generated/restaurant/MenuShape> ;
            shacl:order 3 ;
            shacl:path <http://schema.org/hasMenu> ],
        [ shacl:node <http://example.org/generated/restaurant/MenuShape> ;
            shacl:order 4 ;
            shacl:path <http://purl.org/goodrelations/v1#offers> ] ;
    shacl:targetClass <http://purl.org/goodrelations/v1#BusinessEntity> .

