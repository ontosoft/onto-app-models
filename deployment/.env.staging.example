# ================================================================
# Staging — template for the STAGING_ENV_FILE secret.
#
# This file is read by no command. Fill in a copy OUTSIDE the repo,
# store its content as the STAGING_ENV_FILE Actions secret (or pass
# it to act via the Makefile) — Ansible writes it verbatim as
# deployment/.env on the VM.
#
# Everything without a default is required: docker-compose.staging.yml
# declares these fields as ${VAR?...}, so the stack refuses to start
# when one is missing or empty. That is deliberate — better an abort
# at start-up than a half-configured stack whose errors surface
# later, far from their cause.
#
# NO key may appear twice. Compose silently takes the LAST
# occurrence of a duplicated key.
# ================================================================

# ----------------------------------------------------------------
# Public entry point / TLS
# ----------------------------------------------------------------
# The ONE public hostname. Must be a DNS name whose records point at
# the VM (A record -> `terraform output vm_ipv4`, AAAA record ->
# `terraform output vm_ip`) — ACME issues certificates for domains,
# never for bare addresses. Keep it a SHALLOW subdomain; the DHBW
# HARICA CA refused deep ones.
APP_HOSTNAME=

# Contact address for the ACME account, not a login.
ACME_EMAIL=

# ACME directory. Unset = Let's Encrypt. If the campus firewall
# blocks LE's validators, set the HARICA directory URL instead.
# ACME_CA_URL=

# ----------------------------------------------------------------
# Backend
# ----------------------------------------------------------------
# Signs the backend's JWT auth and password-reset tokens. Any long
# random value; generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Rotating it invalidates all issued tokens (everyone is logged out).
SECRET_KEY=

# Login of the superuser account that scripts/prestart.sh seeds into
# the database on first start (an email address) and its password.
FIRST_SUPERUSER=
FIRST_SUPERUSER_PASSWORD=

# Base domain the backend uses when it builds absolute links (e.g.
# in emails), and the frontend origin it always allows for CORS.
DOMAIN=
FRONTEND_HOST=

# Tells Settings which profile runs; staging here.
ENVIRONMENT=staging

# Extra origins allowed for CORS, comma-separated (a JSON list also
# works). Must include https://<APP_HOSTNAME>, otherwise the browser
# blocks the frontend's API calls.
BACKEND_CORS_ORIGINS=

# Required by the backend's Settings validation (a label from the
# original template); no service in the staging stack reads it.
STACK_NAME=onto-app-staging

# Required by Settings validation (no defaults in app/core/config.py);
# prestart aborts with a pydantic ValidationError when any is missing.
PROJECT_NAME=OntoUI

# Neo4j credentials for the (future) RAG retrieval store. There is NO
# neo4j service in the staging stack yet - placeholders satisfy the
# validation until that work lands.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=unused

# ----------------------------------------------------------------
# Images
# ----------------------------------------------------------------
# Local tags for the images built on the VM; no registry involved.
DOCKER_IMAGE_BACKEND=llm-model-generator-api
DOCKER_IMAGE_FRONTEND=onto-app-frontend
# TAG=latest

# ----------------------------------------------------------------
# Postgres
# ----------------------------------------------------------------
# Used by the db container itself and by the backend's connection.
# The server/port point inside the compose network - leave them.
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=
POSTGRES_PASSWORD=

# ----------------------------------------------------------------
# Optional
# ----------------------------------------------------------------
# SMTP for outgoing mail (password reset etc.); off when unset.
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASSWORD=
# EMAILS_FROM_EMAIL=
# Error reporting; off when unset.
# SENTRY_DSN=
