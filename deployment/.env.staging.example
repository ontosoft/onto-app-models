# Template for the STAGING_ENV_FILE secret: the staging stack's entire
# runtime .env. Ansible writes the secret verbatim to /home/ubuntu/app/.env
# on the VM. Keys marked (required) back a ${VAR?...} guard in
# docker-compose.staging.yml - compose refuses to start without them.
#
# Do NOT define a key twice: compose silently takes the last occurrence.

# --- Public entry point (required) ------------------------------------------
# The one public hostname; A record -> the VM's secondary IPv4 (terraform
# output vm_ipv4), AAAA record -> its IPv6 (terraform output vm_ip). Keep it
# a SHALLOW subdomain - HARICA's ACME finalize failed on deep ones.
APP_HOSTNAME=
# ACME account email (required).
ACME_EMAIL=
# ACME directory. Default (unset) is Let's Encrypt; if the campus firewall
# blocks LE's validators, set the HARICA directory URL here instead.
# ACME_CA_URL=

# --- Backend settings (required unless noted) --------------------------------
DOMAIN=
FRONTEND_HOST=
ENVIRONMENT=staging
# Must include https://<APP_HOSTNAME> or the browser blocks API calls.
BACKEND_CORS_ORIGINS=
SECRET_KEY=
FIRST_SUPERUSER=
FIRST_SUPERUSER_PASSWORD=
STACK_NAME=onto-app-staging

# --- Images (required) --------------------------------------------------------
DOCKER_IMAGE_BACKEND=llm-model-generator-api
DOCKER_IMAGE_FRONTEND=onto-app-frontend
# TAG=latest

# --- Database (required) ------------------------------------------------------
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- Optional -----------------------------------------------------------------
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASSWORD=
# EMAILS_FROM_EMAIL=
# SENTRY_DSN=
