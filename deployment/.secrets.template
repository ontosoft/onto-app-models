# OpenStack Staging Secrets (application credentials for the NEW cluster)
STAGING_OS_AUTH_URL=
STAGING_OS_APPLICATION_CREDENTIAL_ID=
STAGING_OS_APPLICATION_CREDENTIAL_SECRET=
STAGING_OS_REGION_NAME=

# The staging stack's entire runtime .env as ONE secret (multi-line).
# Ansible writes it to the VM verbatim; see .env.staging.example for the
# required keys. For act, a multi-line value is easiest passed on the CLI:
#   act ... -s STAGING_ENV_FILE="$(cat /path/to/staging.env)"
STAGING_ENV_FILE=

# Shared Secrets
# An UNENCRYPTED private key; Terraform registers its public half as the
# OpenStack keypair. Also easiest passed on the CLI:
#   act ... -s SSH_PRIVATE_KEY="$(cat ~/.ssh/openstack-deploy)"
SSH_PRIVATE_KEY=
