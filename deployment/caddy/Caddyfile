# Reverse proxy for staging. Built image with the rfc2136 module - see
# caddy/Dockerfile for why the stock image does not work here.
#
# Caddy obtains and renews the certificate itself over ACME dns-01: it writes
# a TXT record under _acme-challenge.<APP_HOSTNAME> via RFC 2136 (TSIG key
# from the zone's self-service "TLS Certificates" page) and the CA reads it
# from DNS. No inbound connection from the CA is needed; the hostname's A
# record only has to point at the VM for the actual visitors.
#
# All variables come from the caddy service's environment in
# docker-compose.staging.yml, which reads them from the deployed .env.

{
	email {$ACME_EMAIL}
	acme_ca {$ACME_CA_URL}
}

{$APP_HOSTNAME} {
	# dns-01 is the only challenge type that works here; the CA's validators
	# cannot open a connection to this VM (campus firewall outside, blocked
	# segment inside). Needs the rfc2136 module from the built image.
	tls {
		dns rfc2136 {
			key_name {$DNS_TSIG_KEY_NAME}
			key_alg {$DNS_TSIG_KEY_ALG}
			key {$DNS_TSIG_KEY}
			server {$DNS_SERVER}
		}
	}

	encode gzip zstd

	# Path-based routing on one hostname: one hostname, one certificate,
	# one set of DNS records (no api.<host> / dashboard.<host> split).

	# The generated frontend client calls /api/v1/...; the doc endpoints
	# live at the backend root.
	handle /api/* {
		reverse_proxy llm-model-generator-api:8000
	}
	handle /docs* {
		reverse_proxy llm-model-generator-api:8000
	}
	handle /openapi.json {
		reverse_proxy llm-model-generator-api:8000
	}

	# Everything else is the frontend SPA.
	handle {
		reverse_proxy frontend:80
	}
}
