# Reverse proxy for staging. Stock caddy:2 image - no plugins.
#
# Caddy obtains and renews the certificate itself over ACME http-01: the CA
# fetches http://<APP_HOSTNAME>/.well-known/acme-challenge/... on port 80,
# which Caddy answers automatically. This requires the hostname's A/AAAA
# records to point at the VM and port 80 to be reachable (the security group
# opens it).
#
# All variables come from the caddy service's environment in
# docker-compose.staging.yml, which reads them from the deployed .env.

{
	email {$ACME_EMAIL}
	acme_ca {$ACME_CA_URL}
}

{$APP_HOSTNAME} {
	encode gzip zstd

	# Path-based routing on one hostname: one shallow hostname, one
	# certificate (HARICA's ACME endpoint refused deep subdomains, so no
	# api.<host> / dashboard.<host> split).

	# The generated frontend client calls /api/v1/...; the doc endpoints
	# live at the backend root.
	handle /api/* {
		reverse_proxy llm-model-generator-api:8000
	}
	handle /docs* {
		reverse_proxy llm-model-generator-api:8000
	}
	handle /openapi.json {
		reverse_proxy llm-model-generator-api:8000
	}

	# Everything else is the frontend SPA.
	handle {
		reverse_proxy frontend:80
	}
}
